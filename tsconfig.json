{
	"compilerOptions": {
		"target": "esnext",
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"rootDir": ".",
		"module": "esnext",
		"moduleResolution": "bundler",
		"paths": {
			"@lolcalc/core/*": [
				"./packages/core/src/*"
			],
			"@lolcalc/data": [
				"./packages/data/src/index.ts"
			],
			"@lolcalc/data/*": [
				"./packages/data/src/*"
			],
			"@lolcalc/data/files/*": [
				"./packages/data/files/*"
			],
			"@lolcalc/shared": [
				"./packages/shared/src/index.ts"
			],
			"@lolcalc/shared/*": [
				"./packages/shared/src/*"
			]
		},
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"strictFunctionTypes": true,
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"declaration": true,
		"declarationDir": "./types",
		"emitDeclarationOnly": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"skipDefaultLibCheck": true,
		"skipLibCheck": true
	},
	"include": [
		"*.ts",
		"packages",
		"scripts"
	],
	"exclude": [
		"node_modules"
	]
}
