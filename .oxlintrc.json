{
	"plugins": ["vue", "oxc", "eslint", "import", "node", "unicorn", "promise", "typescript"],
	"ignorePatterns": ["packages/data/files/**/*.json", "packages/core/test/fixtures/*.json"],
	"options": {
		"typeAware": true
	},
	"rules": {
		"prefer-const": ["warn", { "destructuring": "all" }],
		"no-unused-expressions": "off",
		"no-unsafe-optional-chaining": "off",
		"no-unused-vars": "off",
		"no-dupe-keys": "off",
		"no-console": ["warn", { "allow": ["warn", "error"] }],
		"typescript/consistent-type-imports": "error",
		"typescript/consistent-type-exports": "warn",
		"typescript/consistent-type-definitions": ["warn", "interface"],
		// most of the disabled typescript rules are because typescript already errors/warns in cases they cover
		"typescript/no-non-null-asserted-optional-chain": "off",
		"typescript/no-floating-promises": "off",
		"typescript/unbound-method": "off",
		"typescript/restrict-template-expressions": "off",
		"typescript/no-base-to-string": "off",
		"typescript/no-useless-default-assignment": "off",
		"typescript/no-for-in-array": "off",
		"typescript/await-thenable": "off",
		"typescript/no-misused-spread": "off",
		// these 2 constituents could be useful but I don't find them necessary atm and they were adding up to a second of linting when other rules took a few ms
		"typescript/no-duplicate-type-constituents": "off",
		"typescript/no-redundant-type-constituents": "off"
	},
	"overrides": [
		{
			"files": ["scripts/*"],
			"rules": {
				"no-console": "off",
				"typescript/consistent-type-imports": ["warn", { "disallowTypeAnnotations": false }]
			}
		}
	]
}
