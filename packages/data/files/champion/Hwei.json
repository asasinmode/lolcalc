	"stringtable": {
		"spell_hweiqq_name": "Devastating Fire",
		"spell_hweiqw_name": "Severing Bolt",
		"spell_hweiqe_name": "Molten Fissure",
		"spell_hweiqq_tooltip": "Hwei paints a blazing fireball that flies out in the target direction. It explodes on the first enemy hit, dealing <magicDamage>@spell.HweiQ:Tooltip_QQDamage@ plus @spell.HweiQ:Tooltip_QQBonusDamage@% max health magic damage</magicDamage> to all enemies in an area.",
		"spell_hweiqw_tooltip": "Hwei paints a long-range, delayed lightning bolt at the target location, dealing <magicDamage>@spell.HweiQ:Tooltip_QWDamage@ magic damage</magicDamage>. Isolated or <status>Immobilized</status> enemies take increased damage based on missing health, up to <magicDamage>@spell.HweiQ:Tooltip_QWBonusDamage@ magic damage</magicDamage>.",
		"spell_hweiqe_tooltip": "Hwei paints a field of exploding volcanic eruptions, creating lingering lava in its path. Every eruption deals <magicDamage>@spell.HweiQ:Tooltip_QEDamage@ magic damage</magicDamage> to enemies hit. Enemies in the lava area are dealt <magicDamage>@spell.HweiQ:Tooltip_QEDamagePerSecond@ magic damage per second</magicDamage> and <status>Slowed</status> by @spell.HweiQE:SlowPercent@%. Each lava pool lasts @spell.HweiQE:Duration@ seconds.",
