	"stringtable": {
		"spell_khazixq_tooltip_0": "Kha'Zix slashes a nearby enemy, dealing <physicalDamage>@spell.KhazixQ:BaseDamage@ physical damage</physicalDamage>. This deals <physicalDamage>@spell.KhazixQ:IsoDamage@ damage</physicalDamage> instead to enemies <keywordMajor>Isolated</keywordMajor> from their allies. ",
		"spell_khazixq_tooltip_1": "<evolve>Evolved Ability - Passive:</evolve> Kha'Zix increases the range of this Ability and his Attacks.<br><br><evolve>Evolved Ability - Active:</evolve> Kha'zix slashes with improved claws, dealing <physicalDamage>@spell.KhazixQ:BaseDamage@ damage</physicalDamage>. Against <keywordMajor>Isolated</keywordMajor> targets, this deals <physicalDamage>@spell.KhazixQ:IsoDamage@ damage</physicalDamage> instead and reduces the Cooldown by @Effect4Amount@%.",
		"spell_listtype_damage": "Damage",
		"spell_khazixw_tooltip_0": "Kha'Zix fires a spike dealing <physicalDamage>@BaseDamage@ physical damage</physicalDamage> to the first enemy hit in a small area. If Kha'Zix is inside the area, he restores <healing>@HealAmount@ Health</healing>",
		"spell_khazixw_tooltip_1": "<evolve>Evolved Ability:</evolve> Kha'Zix fires 3 spikes, each dealing <physicalDamage>@BaseDamage@ physical damage</physicalDamage> to the first target hit in an area and revealing and <status>Slowing</status> by @Effect3Amount@% for @Effect4Amount@ seconds. Kha'Zix restores <healing>@HealAmount@ Health</healing> if he is within the blast. <keywordMajor>Isolated</keywordMajor> enemies are <status>Slowed</status> by @Effect7Amount@% instead.",
		"spell_listtype_healing": "Healing",
		"spell_khazixe_tooltip_0": "Kha'Zix leaps, dealing <physicalDamage>@TotalDamage@ physical damage</physicalDamage> upon landing.",
		"spell_khazixe_tooltip_1": "<evolve>Evolved Ability:</evolve> Kha'Zix leaps a further distance, dealing <physicalDamage>@TotalDamage@ physical damage</physicalDamage> upon landing. This Ability's Cooldown is refreshed on champion takedown.",
		"spell_khazixr_tooltip_0": "<spellActive>Active:</spellActive> Kha'Zix becomes <keywordStealth>Invisible</keywordStealth> for @StealthDuration@ seconds and gains <speed>@BonusMovementSpeedPercent*100@% Move Speed</speed>. Kha'zix may <recast>Recast</recast> this Ability once within @RecastWindow@ seconds.",
		"spell_khazixr_tooltip_1": "<evolve>Evolved Ability:</evolve> Kha'Zix becomes <keywordStealth>Invisible</keywordStealth> for an improved @EvolvedStealthDuration@ seconds and gains <speed>@BonusMovementSpeedPercent*100@% Move Speed</speed>. Kha'zix may <recast>Recast</recast> this Ability twice within 10 seconds.",
		"spell_khazixq_name": "Taste Their Fear",
		"spell_khazixw_name": "Void Spike",
		"spell_khazixe_name": "Leap",
		"spell_khazixr_name": "Void Assault",
		"spell_khazixr_tooltip_p": "<spellPassive>Passive:</spellPassive> Leveling up this Ability allows Kha'zix to <evolve>Evolve</evolve> one of his Abilities, granting it additional effects.<li><spellName>Taste Their Fear:</spellName> Gain Ability range, Attack range, and lowers Cooldown by @spell.KhazixQ:Effect4Amount@% against <keywordMajor>Isolated</keywordMajor> targets.<li><spellName>Void Spike:</spellName> Fires 3 spikes and <status>Slows</status> by @spell.KhazixW:Effect3Amount@%, increased against <keywordMajor>Isolated</keywordMajor> targets.<li><spellName>Leap:</spellName> Increased range and refreshes Cooldown on champion takedown.<li><spellName>Void Assault:</spellName> <keywordStealth>Invisibility</keywordStealth> duration lasts @EvolvedStealthDuration@ seconds and gains second <recast>Recast</recast>.",
		"reminder_invisibility": "<keywordStealth>Invisible</keywordStealth> units cannot be revealed except by turrets or <font color='#ee91d7'>True Sight</font color>.",
		"spell_listtype_khazixrevolutionsavailable": "Evolutions Available"
	}
}