{
	"name": "@lolcalc/monorepo",
	"version": "0.0.1",
	"private": true,
	"description": "collection of tools and apps related to lolcalc",
	"license": "AGPL-3.0-only",
	"author": "Stanisław Perek<https://github.com/asasinmode>",
	"type": "module",
	"scripts": {
		"typecheck:packages": "tsc --noEmit",
		"typecheck:website": "cd packages/website && pnpm typecheck",
		"typecheck": "run-p --aggregate-output -c \"typecheck:packages\" \"typecheck:website\"",
		"fmt": "pnpm --ignore-scripts exec oxfmt",
		"lint": "pnpm --ignore-scripts exec oxlint",
		"lint:fix": "pnpm --ignore-scripts exec oxlint --fix",
		"test:shared": "cd packages/shared && node --test",
		"test:core": "cd packages/core && node --test",
		"test": "run-p --aggregate-output -c test:shared test:core"
	},
	"devDependencies": {
		"@lolcalc/core": "workspace:*",
		"@lolcalc/data": "workspace:*",
		"@lolcalc/shared": "workspace:*",
		"@lolcalc/website": "workspace:*",
		"@types/node": "catalog:",
		"husky": "catalog:",
		"lint-staged": "catalog:",
		"npm-run-all2": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vue-tsc": "catalog:"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,vue}": "pnpm run lint:fix"
	},
	"packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
